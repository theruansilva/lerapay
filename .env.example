# Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=lerapay_baas

# JWT Secret
JWT_SECRET=lerapay_default_super_secret_jwt_key_2026
JWT_EXPIRES_IN=7d

# Lera Box Gateway / BranchPay API Configuration
# These credentials must be obtained from your real merchant account on Lera Box / BranchPay.
# There is no simulation fallback; real gateway credentials are required.
GATEWAY_API_URL=https://api.branchpay.com.br/api
GATEWAY_EMAIL=
GATEWAY_PASSWORD=
GATEWAY_CLIENT_CODE=
GATEWAY_STORE_KEY=

# Webhook Callback Verification Secret
# Secret configured in the Lera Box merchant panel to sign outgoing callbacks.
# If configured, signature verification via HMAC SHA256 is enforced on /api/webhooks.
GATEWAY_WEBHOOK_SECRET=

# CORS Configuration (Production only)
# Comma-separated list of allowed origins in production. E.g. https://merchant.domain.com
CORS_ALLOWED_ORIGINS=
